modules = ["python-3.12"]
run = "python -m pytest tests/ -v"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[workflows]
runButton = "Run Web App"

[[workflows.workflow]]
name = "Test Arabic TTS"
author = 46301053
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python test_system.py"

[[workflows.workflow]]
name = "Run Web App"
author = 46301053
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"

[deployment]
run = ["sh", "-c", "python -m pytest tests/ -v"]

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
